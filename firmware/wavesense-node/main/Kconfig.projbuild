menu "WaveSense 3D node"
    config WAVESENSE_WIFI_SSID
        string "WiFi SSID (default, overridden by provisioning)"
        default "wavesense"
    config WAVESENSE_WIFI_PASSWORD
        string "WiFi password"
        default "wavesense123"
    config WAVESENSE_TARGET_IP
        string "Jetson / server IP address"
        default "192.168.1.100"
    config WAVESENSE_TARGET_PORT
        int "Server UDP port"
        default 5005
    config WAVESENSE_NODE_ID
        int "Node id (1-3)"
        range 1 255
        default 1
    config WAVESENSE_RATE_HZ
        int "Target CSI frames per second"
        range 5 200
        default 50
endmenu
